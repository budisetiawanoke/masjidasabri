# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.db

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# berkas yang diunggah pengguna saat runtime (lihat src/lib/upload.ts) —
# bukan bagian dari source code, dan menumpuk seiring pemakaian aplikasi
/public/uploads/
*.pdf

# hasil build APK yang tercecer di root repo (bukan android/, yang sudah
# py punya .gitignore sendiri) — berkas biner besar, bukan source code
/*.apk

# materi desain referensi (mis. ekspor Figma) — bukan source code, ukuran
# besar; simpan di luar repo (Drive/Dropbox) kalau perlu diarsipkan
/Desain Aplikasi*/
/Desain Aplikasi*.zip

# kunci service account Firebase/Google Cloud (Cloud Storage untuk upload
# berkas, lihat src/lib/firebase-admin.ts) — RAHASIA, jangan pernah commit
*firebase-adminsdk*.json
/service-account*.json
