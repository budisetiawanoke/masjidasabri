// Masjid ASABRI — skema data inti.
// PostgreSQL di semua lingkungan (dev lokal via Homebrew, test lokal via
// database Postgres terpisah, produksi via Supabase) — supaya perilaku
// database yang diuji secara lokal benar-benar sama dengan yang dipakai di
// produksi (lihat docs/ARCHITECTURE.md dan docs/DEPLOYMENT.md).
//
// `directUrl` WAJIB diisi di semua lingkungan (bukan hanya produksi) —
// Prisma memvalidasi variabel env ini ada begitu field-nya dideklarasikan
// di sini, walau di dev lokal nilainya sama saja dengan DATABASE_URL (tidak
// ada pooler di Postgres lokal). Di produksi (Supabase) keduanya BEDA:
// DATABASE_URL = connection pooler (port 6543, dipakai runtime aplikasi di
// Vercel — cocok untuk serverless), DIRECT_URL = koneksi langsung (port
// 5432, dipakai khusus saat migrasi skema karena pooler transaksi Supabase
// tidak mendukung prepared statement multi-perintah yang dibutuhkan
// `prisma migrate`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  BENDAHARA
  JAMAAH
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(JAMAAH)
  isActive      Boolean   @default(true)
  memberId      String?   @unique
  member        Member?   @relation(fields: [memberId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transactionsRecorded   Transaction[]         @relation("RecordedBy")
  transactionsApproved   Transaction[]         @relation("ApprovedBy")
  transactionRevisions   TransactionRevision[]
  auditLogs              AuditLog[]
  suggestionsCreated     SuggestionTicket[]    @relation("SuggestionAuthor")
  suggestionsHandled     SuggestionTicket[]    @relation("SuggestionHandler")
  announcements          Announcement[]
  events                 Event[]
  inventoryItems         InventoryItem[]
  maintenanceLogs        MaintenanceLog[]

  @@index([role])
}

model FoundationProfile {
  id              String   @id @default(cuid())
  name            String   @default("Yayasan Masjid ASABRI Jatiasih")
  shortName       String   @default("Masjid ASABRI")
  periodLabel     String   @default("2026 – 2030")
  address         String
  city            String   @default("Bekasi")
  latitude        Float    @default(-6.2734)
  longitude       Float    @default(106.9925)
  phone           String?
  email           String?
  bankName        String?
  bankAccountNo   String?
  bankAccountName String?
  qrisImageUrl    String?
  aboutText       String   @default("")
  updatedAt       DateTime @updatedAt
}

model BoardMember {
  id         String   @id @default(cuid())
  name       String
  position   String   // e.g. "Ketua Yayasan", "Bendahara"
  periodLabel String  @default("2026 – 2030")
  photoUrl   String?
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Member {
  id          String    @id @default(cuid())
  fullName    String
  gender      String?   // "L" | "P"
  birthDate   DateTime?
  address     String?
  domicile    String?
  phone       String?
  email       String?
  isVolunteer Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User?
  transactions Transaction[]

  @@index([domicile])
}

model TransactionCategory {
  id        String   @id @default(cuid())
  name      String   @unique // Infaq, Sedekah, Zakat, Wakaf, Pembangunan, Operasional, ...
  kind      String   // "MASUK" | "KELUAR"
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  transactions Transaction[]
}

// Transaksi bersifat append-only untuk kolom keuangan inti (amount, kind, categoryId).
// Koreksi dilakukan lewat TransactionRevision (riwayat), bukan overwrite langsung,
// supaya laporan publik selalu bisa diaudit.
model Transaction {
  id            String    @id @default(cuid())
  date          DateTime
  categoryId    String
  category      TransactionCategory @relation(fields: [categoryId], references: [id])
  amount        Int       // dalam rupiah, integer (hindari float untuk uang)
  description   String
  memberId      String?
  member        Member?   @relation(fields: [memberId], references: [id])
  recordedById  String
  recordedBy    User      @relation("RecordedBy", fields: [recordedById], references: [id])
  status        String    @default("PENDING") // PENDING | APPROVED | VOID
  approvedById  String?
  approvedBy    User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  voidReason    String?
  attachmentUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  revisions TransactionRevision[]

  // Infaq/sadaqah publik berperuntukan "Operasional Masjid" otomatis dicatat
  // sebagai transaksi kas lewat relasi ini — lihat InfaqRecord.transactionId
  // dan src/server/donations/service.ts (registerInfaqPublic).
  infaqRecord InfaqRecord?

  @@index([date])
  @@index([status])
  @@index([categoryId])
}

model TransactionRevision {
  id            String   @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  changedById   String
  changedBy     User     @relation(fields: [changedById], references: [id])
  beforeJson    String   // snapshot JSON sebelum perubahan
  afterJson     String   // snapshot JSON sesudah perubahan
  reason        String
  createdAt     DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // "KAJIAN" | "TPA" | "PHBI" | "RAPAT" | "LAINNYA"
  startAt     DateTime
  endAt       DateTime?
  location    String?
  speaker     String?
  posterUrl   String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startAt])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  imageUrl    String? // banner/gambar pengumuman (opsional), diunggah pengurus
  isPinned    Boolean  @default(false)
  publishedAt DateTime @default(now())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  @@index([publishedAt])
}

model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  category      String
  condition     String   @default("BAIK") // BAIK | PERLU_PERBAIKAN | RUSAK
  quantity      Int      @default(1)
  location      String?
  acquiredAt    DateTime?
  notes         String?
  responsibleId String?
  responsible   User?    @relation(fields: [responsibleId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  maintenanceLogs MaintenanceLog[]
}

model MaintenanceLog {
  id              String   @id @default(cuid())
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id])
  description     String
  cost            Int?
  performedAt     DateTime
  loggedById      String
  loggedBy        User     @relation(fields: [loggedById], references: [id])
  createdAt       DateTime @default(now())
}

model ZakatRecord {
  id            String   @id @default(cuid())
  type          String   // "FITRAH" | "MAAL"
  payerName     String
  payerContact  String?
  familyCount   Int      @default(1)
  amountRice    Float?   // kg beras (fitrah)
  amountMoney   Int?     // rupiah
  proofImageUrl String?  // bukti transfer (opsional), diunggah publik tanpa akun
  distributedTo String?
  status        String   @default("DITERIMA") // DITERIMA | DISALURKAN
  recordedAt    DateTime @default(now())
}

model QurbanRecord {
  id            String   @id @default(cuid())
  animalType    String   // "SAPI_EKOR" | "SAPI_PATUNGAN" | "KAMBING_DOMBA"
  qurbanFor     String   // atas nama
  contactPhone  String?
  sharesCount   Int      @default(1)
  amountPaid    Int
  proofImageUrl String?  // bukti transfer (opsional), diunggah publik tanpa akun
  status        String   @default("TERDAFTAR") // TERDAFTAR | LUNAS | DISEMBELIH | DIDISTRIBUSI
  year          Int
  recordedAt    DateTime @default(now())
}

// Infaq/Sadaqah — kategori tetap (bukan kampanye), untuk kebutuhan rutin
// masjid: operasional, dhuafa, anak yatim. Pengiriman publik, tanpa akun,
// dengan lampiran bukti transfer opsional (foto/screenshot).
model InfaqRecord {
  id            String   @id @default(cuid())
  category      String   // "OPERASIONAL" | "DHUAFA" | "ANAK_YATIM"
  donorName     String
  contactInfo   String?
  amount        Int?     // opsional — sebagian donatur mungkin tidak mau sebutkan nominal
  proofImageUrl String?
  status        String   @default("DITERIMA") // DITERIMA | DIKONFIRMASI
  recordedAt    DateTime @default(now())

  // Diisi otomatis saat category = "OPERASIONAL" dan amount terisi — lihat
  // registerInfaqPublic() di src/server/donations/service.ts. Nullable karena
  // infaq untuk DHUAFA/ANAK_YATIM tidak masuk kas masjid (disalurkan
  // langsung, bukan operasional), dan infaq tanpa nominal tidak punya apa pun
  // untuk dicatat di kas.
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([recordedAt])
}

// Donasi — dikelompokkan per kampanye ("sesuai kebutuhan": bencana alam,
// bela Palestina, pembangunan masjid, dst.) yang dibuat pengurus sesuai
// kebutuhan, bukan daftar tetap seperti InfaqRecord.
model DonationCampaign {
  id          String   @id @default(cuid())
  title       String
  description String?

  // Rekening tujuan transfer KHUSUS kampanye ini (opsional) — beberapa
  // kampanye, mis. bantuan bencana, kadang pakai rekening berbeda dari
  // rekening operasional yayasan (FoundationProfile.bankAccountNo).
  // Kosong berarti jamaah memakai rekening yayasan umum (lihat halaman
  // Beranda) — lihat src/app/(public)/donasi/page.tsx untuk fallback-nya.
  bankName        String?
  bankAccountNo   String?
  bankAccountName String?

  isActive  Boolean  @default(true)
  // Keterangan pengurus untuk jamaah saat kampanye ditutup — mis. "Dana
  // telah disalurkan ke korban bencana X pada tanggal Y". Diisi bersamaan
  // dengan menonaktifkan kampanye (lihat closeCampaign() di
  // src/server/donations/service.ts), tetap tampil di laporan publik
  // kampanye walau kampanyenya sudah tidak aktif.
  closingNote String?
  createdAt   DateTime @default(now())

  donations DonationRecord[]
}

model DonationRecord {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      DonationCampaign @relation(fields: [campaignId], references: [id])
  donorName     String
  contactInfo   String?
  amount        Int?
  proofImageUrl String?
  status        String   @default("DITERIMA") // DITERIMA | DIKONFIRMASI
  recordedAt    DateTime @default(now())

  @@index([recordedAt])
}

model SuggestionTicket {
  id           String   @id @default(cuid())
  subject      String
  message      String
  category     String   @default("SARAN") // SARAN | PENGADUAN
  isAnonymous  Boolean  @default(false)
  authorId     String?
  author       User?    @relation("SuggestionAuthor", fields: [authorId], references: [id])
  contactInfo  String?
  status       String   @default("BARU") // BARU | DITINDAKLANJUTI | SELESAI
  response     String?
  handledById  String?
  handledBy    User?    @relation("SuggestionHandler", fields: [handledById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Kode pelacakan publik (mis. "AB3D-9F2K") — jalan bagi SIAPA SAJA untuk
  // mengecek status tiketnya di /kotak-saran/cek-status TANPA perlu akun.
  // Nullable karena tiket lama (sebelum kolom ini ada) tidak punya kode;
  // setiap tiket BARU selalu diberi kode oleh createSuggestion().
  trackingCode String? @unique
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String   // e.g. "TRANSACTION_CREATE", "USER_ROLE_CHANGE"
  entityType String
  entityId   String
  metaJson   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
